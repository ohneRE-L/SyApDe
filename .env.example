# Параметры подключения к PostgreSQL
DB_USER=helpdesk_user
DB_PASSWORD=helpdesk_password
DB_NAME=helpdesk_db
DB_HOST=db
DB_PORT=5432
DB_MAX_CONNS=10

# Порты на хост-машине
DB_HOST_PORT=5432
HTTP_PORT=8080

# Параметры приложения
APP_NAME="Helpdesk Service Desk API"
APP_ENV=development
APP_VERSION=1.0.0
